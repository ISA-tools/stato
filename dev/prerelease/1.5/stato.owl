        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000119"/>
        <IRI>http://purl.obolibrary.org/obo/STATO_0000455</IRI>
        <Literal xml:lang="en">Adapted from Wikipedia:
https://en.wikipedia.org/wiki/Credible_interval

and from the Cambridge Dictionary of Statistics, fourth edition, ISBN-13 978-0-511-78827-7
last accessed: 2017-07-01</Literal>
