        <IRI>http://purl.obolibrary.org/obo/STATO_0000560</IRI>
        <Literal xml:lang="en">Rao-Scott test</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000119"/>
        <IRI>http://purl.obolibrary.org/obo/STATO_0000560</IRI>
        <Literal>Rao, JNK, Scott, AJ (1984) &quot;On Chi-squared Tests For Multiway Contingency Tables with Proportions Estimated From Survey Data&quot; Annals of Statistics 12:46-60.</Literal>
    </AnnotationAssertion>
