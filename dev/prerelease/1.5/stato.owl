        <IRI>http://purl.obolibrary.org/obo/STATO_0000638</IRI>
        <Literal>number needed to treat to harm</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000119"/>
        <IRI>http://purl.obolibrary.org/obo/STATO_0000638</IRI>
        <Literal>https://www.cebm.ox.ac.uk/resources/ebm-tools/glossary</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://purl.obolibrary.org/obo/STATO_0000638</IRI>
        <Literal>number needed to harm</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000114"/>
        <IRI>http://purl.obolibrary.org/obo/STATO_0000639</IRI>
        <IRI>http://purl.obolibrary.org/obo/IAO_0000122</IRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000115"/>
