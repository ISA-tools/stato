        <IRI>http://purl.obolibrary.org/obo/STATO_0000420</IRI>
        <Literal xml:lang="en">I-squared</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000114"/>
        <IRI>http://purl.obolibrary.org/obo/STATO_0000421</IRI>
