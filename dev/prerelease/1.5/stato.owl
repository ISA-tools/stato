        <Literal xml:lang="en">Words, sentences, paragraphs, and the written (non-figure) parts of publications are all textual entities</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000114"/>
        <IRI>http://purl.obolibrary.org/obo/IAO_0000300</IRI>
