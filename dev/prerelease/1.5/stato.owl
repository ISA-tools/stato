        <IRI>http://purl.obolibrary.org/obo/STATO_0000638</IRI>
        <Literal>NNH</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000118"/>
        <IRI>http://purl.obolibrary.org/obo/STATO_0000638</IRI>
        <Literal>NNTH</Literal>
    </AnnotationAssertion>
