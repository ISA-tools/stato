        <Literal xml:lang="en">pppvalue(x, parameter = &quot;mu&quot;, value = 0.0,
           alternative = c(&quot;two.sided&quot;, &quot;less&quot;, &quot;greater&quot;),
           statistic = &quot;median&quot;,
           rejection.region,
           n = 10,
           prior = FALSE,
           quietly = FALSE,
           parallel, seed, ...)

from:
https://search.r-project.org/CRAN/refmans/bayesmeta/html/pppvalue.html</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://purl.obolibrary.org/obo/STATO_0000660</IRI>
        <Literal xml:lang="en">posterior predictive value</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000114"/>
        <IRI>http://purl.obolibrary.org/obo/STATO_0000661</IRI>
        <IRI>http://purl.obolibrary.org/obo/IAO_0000122</IRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <IRI>http://purl.obolibrary.org/obo/STATO_0000661</IRI>
        <Literal xml:lang="en">A p-value which represents the probability of obtaining a result at least as far, in one direction, from the value actually obtained as the value expected, assuming the null hypothesis is true.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000116"/>
        <IRI>http://purl.obolibrary.org/obo/STATO_0000661</IRI>
        <Literal xml:lang="en">P-value is defined as a hypothesis testing measure that represents the probability of obtaining a result at least as far from the value actually obtained as the value expected, assuming the null hypothesis is true. A p-value for one-sided test interprets &apos;at least as far from&apos; with either the direction of &apos;greater than&apos; or the direction of &apos;less than&apos; but not with both possible directions.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000117"/>
        <IRI>http://purl.obolibrary.org/obo/STATO_0000661</IRI>
        <Literal>Brian S. Alper</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000117"/>
        <IRI>http://purl.obolibrary.org/obo/STATO_0000661</IRI>
        <Literal xml:lang="en">Harold Lehmann</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000117"/>
        <IRI>http://purl.obolibrary.org/obo/STATO_0000661</IRI>
        <Literal xml:lang="en">Kenneth Wilkins</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000117"/>
        <IRI>http://purl.obolibrary.org/obo/STATO_0000661</IRI>
        <Literal xml:lang="en">Philippe Rocca-Serra</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
