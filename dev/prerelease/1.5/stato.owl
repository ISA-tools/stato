        <IRI>http://purl.obolibrary.org/obo/STATO_0000663</IRI>
        <IRI>http://purl.obolibrary.org/obo/IAO_0000122</IRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <IRI>http://purl.obolibrary.org/obo/STATO_0000663</IRI>
        <Literal xml:lang="en">The F-beta score is a measure of a model&apos;s accuracy, specifically designed to evaluate the performance of binary classification models. It is a generalized form of the F1 score, which itself is the harmonic mean of precision and recall. The F-beta score introduces a way to weigh recall more heavily than precision (or vice versa) depending on the value of beta.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000116"/>
        <IRI>http://purl.obolibrary.org/obo/STATO_0000663</IRI>
        <Literal xml:lang="en">https://github.com/ISA-tools/stato/pull/86</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
