        <IRI>http://purl.obolibrary.org/obo/OBI_0200043</IRI>
        <IRI>http://purl.obolibrary.org/obo/obi.owl</IRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://purl.obolibrary.org/obo/OBI_0200043</IRI>
        <Literal xml:lang="en">average linkage hierarchical clustering</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000111"/>
        <IRI>http://purl.obolibrary.org/obo/OBI_0200044</IRI>
        <Literal xml:lang="en">complete linkage hierarchical clustering</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000114"/>
        <IRI>http://purl.obolibrary.org/obo/OBI_0200044</IRI>
        <IRI>http://purl.obolibrary.org/obo/IAO_0000120</IRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000115"/>
