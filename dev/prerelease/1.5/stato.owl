        <Literal xml:lang="en">Schwartz&apos;s Baeysian information criterion</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/STATO_0000041"/>
        <IRI>http://purl.obolibrary.org/obo/STATO_0000327</IRI>
        <Literal xml:lang="en"></Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
