        <Literal>Expert Working Group Agreement:  2022-09-14 vote 6-0 by Nisha Mathew, Philippe Rocca-Serra, Harold Lehmann, Eric Harvey, Jesus Lopez-Alcalde, Khalid Shahin</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
