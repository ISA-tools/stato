    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://purl.obolibrary.org/obo/STATO_0000558</IRI>
        <Literal xml:lang="en">statistical model term testing</Literal>
    </AnnotationAssertion>
