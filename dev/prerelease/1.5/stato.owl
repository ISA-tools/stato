        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000118"/>
        <IRI>http://purl.obolibrary.org/obo/STATO_0000652</IRI>
        <Literal>predictive model calibration</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000119"/>
        <IRI>http://purl.obolibrary.org/obo/STATO_0000652</IRI>
        <Literal>STATO
adapted from ChatGPT3.5 with the following prompt: &quot;define &apos;calibration&apos; in the context of statistics&quot;</Literal>
    </AnnotationAssertion>
