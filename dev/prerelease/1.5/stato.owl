        <IRI>http://purl.obolibrary.org/obo/STATO_0000420</IRI>
        <Literal xml:lang="en">http://www.ncbi.nlm.nih.gov/pmc/articles/PMC192859/

and 

http://www.statsdirect.com/help/default.htm#meta_analysis/heterogeneity.htm</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/STATO_0000041"/>
        <IRI>http://purl.obolibrary.org/obo/STATO_0000420</IRI>
        <Literal xml:lang="en"></Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
