        <Literal xml:lang="en">https://pdfs.semanticscholar.org/bb4b/d979610388c76bb81568f14a886304ce4662.pdf</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
