        <IRI>http://purl.obolibrary.org/obo/STATO_0000422</IRI>
        <Literal xml:lang="en">http://www.inside-r.org/packages/cran/meta/docs/labbe.metabin</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://purl.obolibrary.org/obo/STATO_0000422</IRI>
        <Literal xml:lang="en">L&apos;Abbe plot</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000114"/>
        <IRI>http://purl.obolibrary.org/obo/STATO_0000423</IRI>
