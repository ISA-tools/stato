        <IRI>http://purl.obolibrary.org/obo/STATO_0000379</IRI>
        <Literal xml:lang="en">The focused information criterion is a measurement data item which aims at facilitating model selection. It was published in 2003 by Claeskens, G. and Hjort, N.L. (2003). &quot;The focused information criterion&quot;.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000117"/>
        <IRI>http://purl.obolibrary.org/obo/STATO_0000379</IRI>
        <Literal xml:lang="en">Alejandra Gonzalez-Beltran</Literal>
    </AnnotationAssertion>
