        <IRI>http://purl.obolibrary.org/obo/OBI_0400044</IRI>
        <Literal xml:lang="en">FACS Calibur</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000114"/>
        <IRI>http://purl.obolibrary.org/obo/OBI_0400044</IRI>
