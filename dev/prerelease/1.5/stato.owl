        <IRI>http://purl.obolibrary.org/obo/STATO_0000428</IRI>
        <Literal xml:lang="en">https://en.wikipedia.org/wiki/Maximum_likelihood_estimation</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
