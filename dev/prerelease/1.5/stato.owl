        <Literal xml:lang="en">Philippe Rocca-Serra</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000119"/>
        <IRI>http://purl.obolibrary.org/obo/STATO_0000450</IRI>
        <Literal xml:lang="en">http://www.blackwellpublishing.com/specialarticles/jcn_9_381.pdf</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/STATO_0000041"/>
