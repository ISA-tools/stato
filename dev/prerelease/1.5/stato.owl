        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000119"/>
        <IRI>http://purl.obolibrary.org/obo/STATO_0000519</IRI>
        <Literal>adapted from Wikipedia:
https://en.wikipedia.org/wiki/Analysis_of_clinical_trials#Last_observation_carried_forward</Literal>
    </AnnotationAssertion>
