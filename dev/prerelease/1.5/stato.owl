        <IRI>http://purl.obolibrary.org/obo/STATO_0000663</IRI>
        <Literal xml:lang="en">Shawn Tan</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000119"/>
        <IRI>http://purl.obolibrary.org/obo/STATO_0000663</IRI>
        <Literal xml:lang="en">adapted from ChatGPT using the following prompt: [what is the F-beta score in statistics]

last accessed: July 2024</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/STATO_0000391"/>
        <IRI>http://purl.obolibrary.org/obo/STATO_0000663</IRI>
