        <IRI>http://purl.obolibrary.org/obo/STATO_0000457</IRI>
        <Literal xml:lang="en">&quot; In clinical trials, it gives you an idea of how much difference there is between the averages of the experimental group and control groups.&quot;</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000114"/>
        <IRI>http://purl.obolibrary.org/obo/STATO_0000457</IRI>
