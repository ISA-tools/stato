        <IRI>http://purl.obolibrary.org/obo/STATO_0000516</IRI>
        <Literal xml:lang="en">https://en.wikipedia.org/wiki/Sampling_(statistics)#Minimax_sampling</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://purl.obolibrary.org/obo/STATO_0000516</IRI>
        <Literal xml:lang="en">minimax sampling</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
