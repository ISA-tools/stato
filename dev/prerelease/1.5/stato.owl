        <IRI>http://purl.obolibrary.org/obo/STATO_0000418</IRI>
        <Literal xml:lang="en">a measure of heterogeneity in meta-analysis  is a data item which aims to describe the variation in study outcomes between studies.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000117"/>
        <IRI>http://purl.obolibrary.org/obo/STATO_0000418</IRI>
