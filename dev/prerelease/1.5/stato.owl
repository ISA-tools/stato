        <Literal xml:lang="en">http://www.ncbi.nlm.nih.gov/pubmed/7791040</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000114"/>
        <IRI>http://purl.obolibrary.org/obo/STATO_0000325</IRI>
