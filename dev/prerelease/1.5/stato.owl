        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000118"/>
        <IRI>http://purl.obolibrary.org/obo/STATO_0000433</IRI>
        <Literal xml:lang="en">test of the marginal homogeneity of a contingency table</Literal>
    </AnnotationAssertion>
