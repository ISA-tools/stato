        <IRI>http://purl.obolibrary.org/obo/STATO_0000525</IRI>
        <IRI>http://purl.obolibrary.org/obo/IAO_0000122</IRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <IRI>http://purl.obolibrary.org/obo/STATO_0000525</IRI>
        <Literal xml:lang="en">a covariance matrix is a square matrix that contains the variances and covariances associated with several variables. The diagonal elements of the matrix contain the variances of the variables and the off-diagonal elements contain the covariances between all possible pairs of variables.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000117"/>
        <IRI>http://purl.obolibrary.org/obo/STATO_0000525</IRI>
        <Literal xml:lang="en">Philippe Rocca-Serra</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000119"/>
        <IRI>http://purl.obolibrary.org/obo/STATO_0000525</IRI>
        <Literal></Literal>
    </AnnotationAssertion>
