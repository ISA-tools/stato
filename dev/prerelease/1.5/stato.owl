        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <IRI>http://purl.obolibrary.org/obo/STATO_0000622</IRI>
        <Literal xml:lang="en">ratio-based measure of association is a measure of association which relies on a quotient of 2 quantities to indicate the strength of the association.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000119"/>
        <IRI>http://purl.obolibrary.org/obo/STATO_0000622</IRI>
        <Literal xml:lang="en">COKA group</Literal>
