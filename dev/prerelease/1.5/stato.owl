        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/STATO_0000032"/>
        <IRI>http://purl.obolibrary.org/obo/STATO_0000560</IRI>
        <Literal>Rao score test</Literal>
    </AnnotationAssertion>
