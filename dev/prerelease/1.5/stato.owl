    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <IRI>http://purl.obolibrary.org/obo/IAO_0000578</IRI>
        <Literal xml:lang="en">An information content entity that consists of a CRID symbol and additional information about the CRID registry to which it belongs.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000116"/>
        <IRI>http://purl.obolibrary.org/obo/IAO_0000578</IRI>
        <Literal xml:lang="en">2014-05-05: In defining this term we take no position on what the CRID denotes. In particular do not assume it denotes a *record* in the CRID registry (since the registry might not have &apos;records&apos;).</Literal>
    </AnnotationAssertion>
