        <IRI>http://purl.obolibrary.org/obo/STATO_0000316</IRI>
        <Literal xml:lang="en">http://www.statpower.net/Steiger%20Biblio/Steiger04.pdf</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
