        <Literal xml:lang="en">Sidik-Jonkman estimator is a data item computed to estimate heterogeneity parameter (estimate of between-study variance) in a random effect model for meta analysis.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000117"/>
        <IRI>http://purl.obolibrary.org/obo/STATO_0000425</IRI>
        <Literal xml:lang="en">Philippe Rocca-Serra</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000119"/>
        <IRI>http://purl.obolibrary.org/obo/STATO_0000425</IRI>
        <Literal xml:lang="en">http://www.ncbi.nlm.nih.gov/pubmed/16955539</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/STATO_0000041"/>
        <IRI>http://purl.obolibrary.org/obo/STATO_0000425</IRI>
        <Literal xml:lang="en">http://www.inside-r.org/packages/cran/meta/docs/metacor

metacor(cor, n, studlab,
        data=NULL, subset=NULL,
        sm=.settings$smcor,
        level=.settings$level, level.comb=.settings$level.comb,
        comb.fixed=.settings$comb.fixed, comb.random=.settings$comb.random,
        hakn=&quot;FALSE&quot;,
        method.tau=&quot;SJ&quot;,
        tau.common=.settings$tau.common,
        prediction=.settings$prediction, level.predict=.settings$level.predict,
        method.bias=.settings$method.bias,
        backtransf=.settings$backtransf,
        title=.settings$title, complab=.settings$complab, outclab=&quot;&quot;,
        byvar, bylab, print.byvar=.settings$print.byvar,
        keepdata=.settings$keepdata
        )</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://purl.obolibrary.org/obo/STATO_0000425</IRI>
        <Literal xml:lang="en">Sidik-Jonkman estimator</Literal>
