        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000111"/>
        <IRI>http://purl.obolibrary.org/obo/RO_0001000</IRI>
        <Literal>derives from</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <IRI>http://purl.obolibrary.org/obo/RO_0001000</IRI>
        <Literal xml:lang="en">this cell derives from this parent cell (cell division)</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <IRI>http://purl.obolibrary.org/obo/RO_0001000</IRI>
        <Literal xml:lang="en">this nucleus derives from this parent nucleus (nuclear division)</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000114"/>
        <IRI>http://purl.obolibrary.org/obo/RO_0001000</IRI>
        <IRI>http://purl.obolibrary.org/obo/IAO_0000125</IRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <IRI>http://purl.obolibrary.org/obo/RO_0001000</IRI>
        <Literal xml:lang="en">a relation between two distinct material entities, the new entity and the old entity, in which the new entity begins to exist when the old entity ceases to exist, and the new entity inherits the significant portion of the matter of the old entity</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000116"/>
        <IRI>http://purl.obolibrary.org/obo/RO_0001000</IRI>
        <Literal xml:lang="en">This is a very general relation. More specific relations are preferred when applicable, such as &apos;directly develops from&apos;.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000118"/>
        <IRI>http://purl.obolibrary.org/obo/RO_0001000</IRI>
        <Literal xml:lang="en">derives_from</Literal>
    </AnnotationAssertion>
