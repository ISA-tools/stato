        <IRI>http://purl.obolibrary.org/obo/BFO_0000019</IRI>
        <Literal xml:lang="en">quality</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/BFO_0000179"/>
        <IRI>http://purl.obolibrary.org/obo/BFO_0000020</IRI>
        <Literal>sdc</Literal>
    </AnnotationAssertion>
