        <IRI>http://purl.obolibrary.org/obo/STATO_0000560</IRI>
        <Literal>Philippe Rocca-Serra</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000118"/>
        <IRI>http://purl.obolibrary.org/obo/STATO_0000560</IRI>
        <Literal xml:lang="en">Lagrange multiplier test</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
