        <IRI>http://purl.obolibrary.org/obo/OBI_0500017</IRI>
        <Literal xml:lang="en">An experiment design type where the label orientations are reversed. exact synonym: flip dye, dye flip</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000117"/>
