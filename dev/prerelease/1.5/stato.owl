        <IRI>http://purl.obolibrary.org/obo/STATO_0000443</IRI>
        <Literal xml:lang="en">The Extreme Studentized Deviate Test  is a statistical test used to detect outliers in a univariate data set assumed to come from a normally distributed population.
The ESD Test differs from the Grubbs&apos; test and the Tietjen-Moore test in the sense that it contains built-in correction for multiple testing.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000117"/>
        <IRI>http://purl.obolibrary.org/obo/STATO_0000443</IRI>
        <Literal xml:lang="en">Philippe Rocca-Serra</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000118"/>
        <IRI>http://purl.obolibrary.org/obo/STATO_0000443</IRI>
        <Literal xml:lang="en">ESD test for outliers</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000118"/>
        <IRI>http://purl.obolibrary.org/obo/STATO_0000443</IRI>
        <Literal xml:lang="en">generalized ESD test for outliers</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000119"/>
        <IRI>http://purl.obolibrary.org/obo/STATO_0000443</IRI>
        <Literal xml:lang="en">Rosner, Bernard (May 1983), Percentage Points for a Generalized ESD Many-Outlier Procedure,Technometrics, 25(2), pp. 165-172.</Literal>
    </AnnotationAssertion>
