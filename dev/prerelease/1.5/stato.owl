        <Literal xml:lang="en">sample mean</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000114"/>
        <IRI>http://purl.obolibrary.org/obo/STATO_0000402</IRI>
