        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://purl.obolibrary.org/obo/STATO_0000491</IRI>
        <Literal xml:lang="en">Conover-Iman test of multiple comparisons using rank sums</Literal>
    </AnnotationAssertion>
