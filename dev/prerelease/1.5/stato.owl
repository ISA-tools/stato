        <IRI>http://purl.obolibrary.org/obo/STATO_0000452</IRI>
        <Literal xml:lang="en">Philippe Rocca-Serra</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000119"/>
        <IRI>http://purl.obolibrary.org/obo/STATO_0000452</IRI>
        <Literal xml:lang="en">https://doi.org/10.1002/0470011815.b2a13035</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/STATO_0000032"/>
        <IRI>http://purl.obolibrary.org/obo/STATO_0000452</IRI>
        <Literal xml:lang="en">Lawley–Hotelling Trace</Literal>
    </AnnotationAssertion>
