        <Literal xml:lang="en">Bayes R</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000114"/>
        <IRI>http://purl.obolibrary.org/obo/STATO_0000547</IRI>
        <IRI>http://purl.obolibrary.org/obo/IAO_0000122</IRI>
    </AnnotationAssertion>
