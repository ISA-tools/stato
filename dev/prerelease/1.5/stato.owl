        <IRI>http://purl.obolibrary.org/obo/STATO_0000421</IRI>
        <Literal xml:lang="en">Tau-squared is an estimate of the between-study variance in a random-effects meta-analysis. The square root of this number (i.e. tau) is the estimated standard deviation of underlying effects across studies.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000117"/>
        <IRI>http://purl.obolibrary.org/obo/STATO_0000421</IRI>
        <Literal xml:lang="en">Philippe Rocca-Serra</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000119"/>
        <IRI>http://purl.obolibrary.org/obo/STATO_0000421</IRI>
        <Literal xml:lang="en">http://handbook.cochrane.org/chapter_9/9_5_4_incorporating_heterogeneity_into_random_effects_models.htm</Literal>
    </AnnotationAssertion>
