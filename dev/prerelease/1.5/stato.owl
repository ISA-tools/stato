        <IRI>http://purl.obolibrary.org/obo/STATO_0000661</IRI>
        <Literal xml:lang="en">one-sided test p-value</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000118"/>
        <IRI>http://purl.obolibrary.org/obo/STATO_0000661</IRI>
        <Literal xml:lang="en">one-tailed test p-value</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000119"/>
        <IRI>http://purl.obolibrary.org/obo/STATO_0000661</IRI>
        <Literal xml:lang="en">COKA/SEVCO group</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://purl.obolibrary.org/obo/STATO_0000661</IRI>
        <Literal xml:lang="en">p-value for one-sided test</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000114"/>
        <IRI>http://purl.obolibrary.org/obo/STATO_0000662</IRI>
        <IRI>http://purl.obolibrary.org/obo/IAO_0000122</IRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <IRI>http://purl.obolibrary.org/obo/STATO_0000662</IRI>
        <Literal xml:lang="en">A p-value which represents the probability of obtaining a result at least as far, in either direction, from the value actually obtained as the value expected, assuming the null hypothesis is true. A p-value for two-sided test interprets &apos;at least as far from&apos; with both the direction of &apos;greater than&apos; and the direction of &apos;less than&apos;. For hypothesis test interpretation, the two-tailed p-value is compared to the alpha setting divided by 2.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000116"/>
        <IRI>http://purl.obolibrary.org/obo/STATO_0000662</IRI>
        <Literal xml:lang="en">P-value is defined as a hypothesis testing measure that represents the probability of obtaining a result at least as far from the value actually obtained as the value expected, assuming the null hypothesis is true. A p-value for one-sided test interprets &apos;at least as far from&apos; with either the direction of &apos;greater than&apos; or the direction of &apos;less than&apos; but not with both possible directions.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
