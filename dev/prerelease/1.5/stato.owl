        <IRI>http://purl.obolibrary.org/obo/OBI_0400078</IRI>
        <Literal>Flow Cytometry: First Principles, by Alice Longobardi Givan, ISBN-10: 0471382248, ISBN-13: 978-0471382249</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000119"/>
        <IRI>http://purl.obolibrary.org/obo/OBI_0400078</IRI>
        <Literal xml:lang="en">John Quinn</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
