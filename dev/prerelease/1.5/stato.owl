    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000117"/>
        <IRI>http://purl.obolibrary.org/obo/STATO_0000623</IRI>
        <Literal>Brian S. Alper, Harold Lehmann, Joanne Dehnbostel</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
