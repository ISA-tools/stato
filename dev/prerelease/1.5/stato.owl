    </Annotation>
    <Annotation>
        <AnnotationProperty IRI="http://purl.org/dc/elements/1.1/subject"/>
        <Literal xml:lang="en">Statistical Method, Design of Experiment, Plots, Statistical Model</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty IRI="http://purl.org/dc/elements/1.1/title"/>
        <Literal>STATO: the statistical methods ontology</Literal>
    </Annotation>
