    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://purl.obolibrary.org/obo/RO_0000056</IRI>
        <Literal xml:lang="en">participates in</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
