        <IRI>http://purl.obolibrary.org/obo/STATO_0000421</IRI>
        <Literal xml:lang="en">http://www.inside-r.org/packages/cran/meta/docs/metacor</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
