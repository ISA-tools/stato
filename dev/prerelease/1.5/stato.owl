        <IRI>http://purl.obolibrary.org/obo/BFO_0000020</IRI>
        <Literal xml:lang="en">the mutual dependence of proton donors and acceptors in chemical reactions [79</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
