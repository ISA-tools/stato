        <IRI>http://purl.obolibrary.org/obo/STATO_0000325</IRI>
        <Literal xml:lang="en">Philippe Rocca-Serra</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000119"/>
        <IRI>http://purl.obolibrary.org/obo/STATO_0000325</IRI>
        <Literal xml:lang="en">http://en.wikipedia.org/wiki/Akaike_information_criterion

and

http://users.ecs.soton.ac.uk/jn2/teaching/aic.pdf</Literal>
    </AnnotationAssertion>
