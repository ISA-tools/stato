        <IRI>http://purl.obolibrary.org/obo/STATO_0000318</IRI>
        <Literal xml:lang="en">Orlaith Burke</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000117"/>
        <IRI>http://purl.obolibrary.org/obo/STATO_0000318</IRI>
        <Literal xml:lang="en">Philippe Rocca-Serra</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000119"/>
        <IRI>http://purl.obolibrary.org/obo/STATO_0000318</IRI>
        <Literal xml:lang="en">adapted from:
http://en.wikipedia.org/wiki/Effect_size#Omega-squared.2C_.CF.892</Literal>
    </AnnotationAssertion>
