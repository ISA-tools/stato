        <IRI>http://purl.obolibrary.org/obo/STATO_0000327</IRI>
        <Literal xml:lang="en">Schwarz, Gideon E. (1978). &quot;Estimating the dimension of a model&quot;. Annals of Statistics 6 (2): 461–464. doi:10.1214/aos/1176344136.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000119"/>
