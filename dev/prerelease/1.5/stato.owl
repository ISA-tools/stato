    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://purl.obolibrary.org/obo/OBI_0400044</IRI>
        <Literal xml:lang="en">flow cytometer</Literal>
